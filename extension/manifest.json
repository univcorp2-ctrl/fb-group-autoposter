{
  "manifest_version": 3,
  "name": "FB Group 物件投稿ヘルパー",
  "version": "1.1.6",
  "description": "Default Chromeプロフィールの実ログインセッション内でFacebookグループへ物件投稿するヘルパー。",
  "permissions": ["tabs", "alarms", "storage", "scripting"],
  "host_permissions": ["https://www.facebook.com/*", "http://127.0.0.1:8766/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/groups/*"],
      "js": ["posts.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
