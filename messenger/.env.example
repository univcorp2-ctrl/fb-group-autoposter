# =============================================================================
# fb-messenger-assistant — Messenger の1対1メッセージを読み取り、返信下書きを保存
# =============================================================================
# このリポジトリは自動投稿 (fb-group-autoposter) とは完全に独立しています。
# 別プロファイル・別.env・別スケジュールで動き、自動投稿には一切干渉しません。
#
# ❗ アカウント停止(BAN)回避の大原則:
#   - デフォルトは「読むだけ」。FBへの書き込みはしません(WRITE_DRAFT_TO_FB=false)。
#   - 下書きは絶対に自動送信しません。送信は必ず人間が行います。
#   - 実行頻度は控えめに(1日数回)。人間らしい間隔・操作を入れています。

# --- 安全モード -------------------------------------------------------------
# true: 読むだけ。下書きは Notion + Telegram に保存(FBには書き込まない)。最も安全。
# false にしても「送信」は絶対しません。下記 WRITE_DRAFT_TO_FB が別途必要です。
READ_ONLY=true

# Tier B (オプトイン): 下書きを FB の入力欄に入れる。ただし送信は絶対にしない。
# 慣れてきたら true に。BANリスクが少し上がるため、初期は false 推奨。
WRITE_DRAFT_TO_FB=false

# --- ブラウザ ---------------------------------------------------------------
# 自動投稿とは別のプロファイル。共有すると自動投稿のプロファイルが壊れるため厳守。
MESSENGER_PROFILE_DIR=profiles/messenger
HEADLESS=false
# 自動投稿と同じ固定UA(変えると checkpoint を誘発しやすい)。
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# 1回の実行でスキャンするスレッド数の上限(控えめに)。
MAX_THREADS_PER_RUN=20

# --- Telegram (自動投稿と同じBOT/チャットでOK) -------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion (返信下書きDB) --------------------------------------------------
# https://www.notion.so/my-integrations でトークン発行 → 下記DBに「コネクト」追加。
NOTION_TOKEN=
# 返信下書きDB「✉️ Messenger 返信下書き」(作成済み)。
NOTION_REPLIES_DATABASE_ID=b60d6aacf75f428696d53544e8b2e402

# --- 返信下書きの差し込みURL ------------------------------------------------
LINE_URL=https://lin.ee/8u8OJTSL
COMMUNITY_URL=https://www.facebook.com/groups/2217518449046952/

# --- 任意: Claudeで自然な返信文面を生成する場合 ------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
