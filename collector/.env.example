# =============================================================================
# 役割3: グループ物件コレクター — FBグループの投稿から物件情報を収集しDB化
# =============================================================================
# READ-ONLY: 投稿・いいね・コメントは一切しません（読むだけ）。
# 投稿(役割1)・Messenger(役割2)とは別プロファイルで、互いに干渉しません。

HEADLESS=false
COLLECTOR_PROFILE_DIR=profiles/collector
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# 1グループあたり収集する投稿数の上限。
MAX_POSTS_PER_GROUP=30

# 収集物件DB（SQLite）とJSONミラーの出力先。
DB_PATH=data/collected.db

# Telegram（任意・役割1/2と同じBOTで可）。収集サマリーを通知。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notion（任意）。収集物件を別DBに記録したい場合。
NOTION_TOKEN=
NOTION_COLLECTED_DATABASE_ID=
