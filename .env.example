# ===== Claude API =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_VISION_MODEL=claude-sonnet-4-6

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 動作モード（フェイルセーフ初期値）=====
DRY_RUN=true
AUTO_APPROVE=false
AUTO_APPROVE_SKIP_DEGRADED=true
HUMANIZE=true

# ===== 投稿ペース・上限（ブロック回避最優先：少なく・自然に）=====
MIN_INTERVAL_MIN=15
MAX_INTERVAL_MIN=35
# 1日あたりの総投稿数の上限（控えめに）。
MAX_POSTS_PER_DAY=2
# 同一グループは「JSTの暦日で1日1回まで」。朝の実行で投稿し、夜の実行は
# 「本日投稿済み」で自動スキップ → 毎日必ず1回・空き日なし・重複なし。
# （時間ベース間隔だと投稿時刻が日々後ろにずれて丸1日抜ける日が出るため廃止）
# 1日2回投稿したい場合は groups.yaml にグループを2つ以上登録する。
# MIN_SAME_GROUP_HOURS は後方互換のため残置（投稿ゲートには未使用）。
MIN_SAME_GROUP_HOURS=24
MAX_GROUPS_PER_BROWSER=5

# ===== リトライ・タイムアウト =====
RETRY_MAX=3
PAGE_HARD_TIMEOUT=120
APPROVAL_TIMEOUT_HOURS=24
HEARTBEAT_TIMEOUT_MIN=30
GROUP_FAIL_THRESHOLD=3
COOLDOWN_HOURS=24

# ===== パス =====
PROFILE_DIR=profiles/main
INBOX_DIR=data/inbox
DB_PATH=data/jobs.db
PROFILE_BACKUP_KEEP=7

# ===== 拡張口 =====
BROWSER_BACKEND=playwright

# ===== ブラウザ指紋（checkpoint回避）=====
# 実在の最新 Windows Chrome の User-Agent を固定で使う。
# ★必ず一定に保つこと★ — UA が変わるのは checkpoint を誘発する最大要因の一つ。
# 同じ理由で、固定IP・自宅などの固定回線（できればレジデンシャルIP）からの実行を推奨。
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
