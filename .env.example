# ===== Claude API =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_VISION_MODEL=claude-sonnet-4-6

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# AUTO_APPROVE時のプレビュー/承認済み通知と内部summaryは通常は送らず、
# 投稿成功/未確認/完了報告だけをTelegramへ出す。
TELEGRAM_NOTIFY_AUTO_APPROVAL=false
TELEGRAM_NOTIFY_PIPELINE_SUMMARY=false

# ===== 動作モード（フェイルセーフ初期値）=====
DRY_RUN=true
AUTO_APPROVE=false
AUTO_APPROVE_SKIP_DEGRADED=true
HUMANIZE=true

# ===== 投稿ペース・上限（ブロック回避最優先：少なく・自然に）=====
MIN_INTERVAL_MIN=15
MAX_INTERVAL_MIN=35
# 1日あたりの総投稿数の上限（控えめに）。
MAX_POSTS_PER_DAY=2
# 同一グループは「JSTの暦日で1日1回まで」。
MIN_SAME_GROUP_HOURS=24
MAX_GROUPS_PER_BROWSER=5

# ===== リトライ・タイムアウト =====
RETRY_MAX=3
PAGE_HARD_TIMEOUT=120
APPROVAL_TIMEOUT_HOURS=24
HEARTBEAT_TIMEOUT_MIN=30
GROUP_FAIL_THRESHOLD=3
COOLDOWN_HOURS=24

# ===== パス =====
PROFILE_DIR=profiles/main
INBOX_DIR=data/inbox
DB_PATH=data/jobs.db
PROFILE_BACKUP_KEEP=7

# ===== 拡張口 =====
BROWSER_BACKEND=playwright

# ===== EstateBoard Facebook投稿分析 =====
ANALYTICS_SYNC_ENABLED=false
ANALYTICS_BASE_URL=https://estateboard.pages.dev
ANALYTICS_INGEST_TOKEN=
ANALYTICS_HTTP_TIMEOUT=30
ANALYTICS_METRICS_HEADLESS=false
ANALYTICS_METRICS_MAX_POSTS=30
ANALYTICS_METRICS_MAX_AGE_DAYS=180

# ===== ブラウザ指紋（checkpoint回避）=====
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
